        "tools/checks/python.sh",
        "tests"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Soulkiller: Python audit",
      "type": "process",
      "command": "bash",
      "args": [
        "tools/checks/python.sh",
        "audit"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Soulkiller: Python all",
      "type": "process",
      "command": "bash",
      "args": [
        "tools/checks/python.sh",
        "all"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
