{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Soulkiller: Python static",
      "type": "process",
      "command": "bash",
      "args": [
        "tools/checks/python.sh",
        "static"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Soulkiller: Python tests",
      "type": "process",
      "command": "bash",
